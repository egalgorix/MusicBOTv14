# Copy to .env and fill in. Environment variables override config.js.

DISCORD_TOKEN=
# Optional. Registers slash commands on this guild instantly instead of globally.
GUILD_ID=

# Optional. Leave empty to run without a database (buttons still work for this process).
MONGO_URL=

# Health check for uptime monitors. Binds 0.0.0.0.
PORT=3000

# Optional path to a newer ffmpeg. A bundled binary is used when this is unset.
FFMPEG_PATH=

# YouTube bot-check workaround (the failure that started in 2023).
# Paste the Cookie header from a logged-in youtube.com browser session.
YOUTUBE_COOKIE=
# Optional InnerTube client: WEB, ANDROID, IOS, TV, TV_EMBEDDED, MWEB
YOUTUBE_CLIENT=WEB
# Optional Proof-of-Origin token if YouTube starts rejecting anonymous streams.
YOUTUBE_PO_TOKEN=
# Optional player id override when YouTube ships a breaking player change.
YOUTUBE_PLAYER_ID=
